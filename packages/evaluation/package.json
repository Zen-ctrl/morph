{
  "name": "@morph/evaluation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/bench.ts --format esm --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit -p ../../tsconfig.json",
    "bench:conformance": "tsx src/bench.ts conformance",
    "bench:tokens": "tsx src/bench.ts tokens",
    "bench:performance": "tsx src/bench.ts performance"
  },
  "dependencies": {
    "@morph/core": "workspace:*",
    "@morph/encoders": "workspace:*",
    "@morph/tokenizer-adapters": "workspace:*",
    "@morph/toon-adapter": "workspace:*"
  }
}
